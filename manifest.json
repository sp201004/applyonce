{
  "manifest_version": 3,
  "name": "ApplyOnce - AI Job Autofill",
  "short_name": "ApplyOnce",
  "version": "1.0.0",
  "description": "ApplyOnce securely autofills job applications with your saved profile and AI assistance.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "options_page": "options/options.html",
  "background": { "service_worker": "background/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content/repeat-groups.js", "content/content.js"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://applyonce1.vercel.app/*"]
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "key": ""
}
