# ============================================================================
# ApplyOnce Web App - Environment Variables
# ----------------------------------------------------------------------------
# Ise copy karke ".env.local" banao (local dev ke liye):
#     cp .env.example .env.local
# Aur Vercel pe deploy karte waqt in same variables ko
# Project Settings -> Environment Variables mein add karo.
# ============================================================================

# --- Supabase (aapke apne project se) ---------------------------------------
# Supabase Dashboard -> Project Settings -> API se milega:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Chrome Extension ID ----------------------------------------------------
# Ye woh ID hai jo chrome://extensions pe aapki loaded extension ke neeche dikhti hai.
# Web app isi ID ke through extension ko session/profile bhejta hai.
# TIP: fixed ID ke liye tools/gen-ext-key.js use karke manifest mein "key" add karo,
#      warna har machine pe ID alag ho sakti hai.
NEXT_PUBLIC_EXTENSION_ID=your-chrome-extension-id
